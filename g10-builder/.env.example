# G10 Builder API configuration.
# Copy to .env and fill in. Never commit .env.

# REQUIRED. Bearer token the API and web UI authenticate with.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUILDER_API_TOKEN=

# Comma-separated origins allowed to call the API from a browser
# (e.g. a separately hosted UI). Leave empty to disable cross-origin
# access entirely — the bundled ./ui works same-origin without it.
# A wildcard '*' is rejected; the server will refuse to start.
BUILDER_ALLOWED_ORIGINS=

# Network binding. 127.0.0.1 = local machine only (default, recommended).
# Set to 0.0.0.0 only behind additional network controls.
BUILDER_HOST=127.0.0.1
BUILDER_PORT=3001

# OpenAI key used by the pipeline (server-side only, never sent to the browser).
OPENAI_API_KEY=

# Optional: run the Builder against a different project checkout
# (used by tests). Defaults to the parent directory of g10-builder/.
# BUILDER_PROJECT_ROOT=

# Optional: override where the approval-mode proposal file is written.
# Normally set automatically per job by the server.
# BUILDER_PROPOSAL_OUT=
